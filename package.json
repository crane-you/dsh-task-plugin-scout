{
  "name": "dsh-task-plugin-scout",
  "version": "1.0.4",
  "description": "Find the plugins that make a task easier — a DeepSeek Harness (DSH) plugin that ranks this profile's installed, disabled and marketplace plugins for the task at hand and prints the exact next step for each. · 按任务排序本机插件（已启用 / 未启用 / 市场可安装）并给出下一步。",
  "type": "module",
  "license": "MIT",
  "author": "crane-you",
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "plugin-manager",
    "plugin-discovery",
    "agent-tools"
  ],
  "homepage": "https://github.com/crane-you/dsh-task-plugin-scout#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crane-you/dsh-task-plugin-scout.git"
  },
  "bugs": {
    "url": "https://github.com/crane-you/dsh-task-plugin-scout/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
